rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users directory — any signed-in user may read (the app lists users
    // to show assignees), but only the owner may create or update their profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Tasks — private to their owner.
    match /users/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Comments — private to the task owner.
    match /users/{uid}/tasks/{taskId}/comments/{commentId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}